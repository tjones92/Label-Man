# Godot 4+ specific ignores
.godot/
/android/

# Scratch output from the removable headless chart-realism audit harness.
# Keep Godot's ignore marker tracked so the editor never imports this archive.
/SimLogs/*
!/SimLogs/.gdignore

# Godot import artifacts generated for the SimTools analysis CSVs.
# The CSVs themselves are tracked; the per-column .translation shards are not.
/SimTools/*.csv.import
/SimTools/*.translation
__pycache__/

# Exported build output; the game data pack is a build artifact, not source.
/data_Label Man_windows_x86_64/

# Godot export presets: machine-local (carries an absolute export path, and can carry
# signing credentials). Build config, not source.
/export_presets.cfg
