+        for (int term = ask.TermYears; term <= 7 && found == null; term++)
+        for (int adv = 0; adv <= 10 && found == null; adv++)
+        for (int step = 0; step <= 60 && found == null; step++) {
+            float advance = Mathf.Ceil(Mathf.Lerp(ask.Advance, minAdvance, adv / 10f));
