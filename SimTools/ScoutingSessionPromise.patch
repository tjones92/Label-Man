@@ -0,0 +1,208 @@
+using System;
+using System.Linq;
+using System.Text.Json;
+using Godot;
+
+public static class ScoutingSessionPromiseChecks {
+    /// <summary>A real heard act, made eligible and managed so that its approach opens the negotiation scene.</summary>
