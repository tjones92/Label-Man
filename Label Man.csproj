<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>LabelMan</RootNamespace>
    <!-- Headless audits load Debug just like the editor. Keep symbols, but allow
         the JIT to optimize the simulation; use -p:Optimize=false for full stepping. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!-- Standalone naming-Core regression harness: its own project + Main, excluded from the game build. -->
  <ItemGroup>
    <Compile Remove="SimTools\NamingCoreTests\**\*.cs" />
    <!-- A checkout of another branch can be nested under tmp\; its sources are not this build's. -->
    <Compile Remove="tmp\playtest-ui-ux-fixes\**\*.cs" />
    <Compile Remove="tmp\scouting-unsigned\**\*.cs" />
  </ItemGroup>
</Project>
