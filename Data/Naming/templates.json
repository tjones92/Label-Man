      "constraints": [ { "type": "distinct", "slots": ["noun#1","noun#2"] }, { "type": "moodInternal" } ] },
    { "id": "folk_simple", "type": "song", "pattern": "%adjective#1% %noun#1%", "weight": 2, "words": [2,3],
      "slots": { "adjective#1": { "pos": "adjective", "filter": "wistful|earnest|defiant" }, "noun#1": { "pos": "noun", "filter": "protest|travel|virtue|terrain" } } }
  ],

