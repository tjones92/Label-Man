{
  "//": "Layer-2 constraint templates, keyed by the song/band symbol the adapter routes to (a set here OVERRIDES the same-named grammar symbol; the grammar stays a per-attempt fallback). Slot filters query the ontology-tagged pools in lexicon.ontology.json; mood constraints keep multi-slot titles coherent per the genre's mood threshold. Each set ends with a simple always-satisfiable template so generation never fails.",

  "songTitle.blues": [
    { "id": "blues_ramble", "type": "song", "pattern": "%verb#1:ger% %connector#1% %noun#1%", "weight": 3, "words": [3,5],
      "slots": { "noun#1": { "pos": "noun", "filter": "grit|travel|fate|vice|emotion" }, "verb#1": { "pos": "verb", "filter": "restless|melancholy" } },
      "constraints": [ { "type": "moodInternal" } ] },
    { "id": "blues_trouble", "type": "song", "pattern": "%adjective#1% %noun#1%", "weight": 2, "words": [2,3],
      "slots": { "adjective#1": { "pos": "adjective", "filter": "gritty|melancholy" }, "noun#1": { "pos": "noun", "filter": "grit|vice|emotion|travel" } },
      "constraints": [ { "type": "moodInternal" } ] },
    { "id": "blues_and", "type": "song", "pattern": "%noun#1% and %noun#2%", "weight": 1, "words": [3,3],
      "slots": { "noun#1": { "pos": "noun", "filter": "grit|vice" }, "noun#2": { "pos": "noun", "filter": "emotion|fate" } },
      "constraints": [ { "type": "distinct", "slots": ["noun#1","noun#2"] } ] },
    { "id": "blues_simple", "type": "song", "pattern": "%noun#1% Blues", "weight": 2, "words": [2,3],
      "slots": { "noun#1": { "pos": "noun", "filter": "grit|travel|emotion|romance" } } }
  ],

