      "slots": { "adjective#1": { "pos": "adjective", "filter": "dreamy|ominous|grand" }, "noun#1": { "pos": "noun", "filter": "mystical|flora|celestial" }, "noun#2": { "pos": "noun", "filter": "mystical|cosmic|celestial|flora" } },
