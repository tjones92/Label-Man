      "constraints": [ { "type": "moodInternal" } ], "transform": ["apostropheDrop"] },
    { "id": "country_simple", "type": "song", "pattern": "%noun#1% %connector#1% %noun#2%", "weight": 1, "words": [3,5],
      "slots": { "noun#1": { "pos": "noun", "filter": "rural|domestic|emotion" }, "noun#2": { "pos": "noun", "filter": "travel|temporal|rural" } },
      "constraints": [ { "type": "distinct", "slots": ["noun#1","noun#2"] } ] }
  ],

  "songTitle.folk": [
    { "id": "folk_triadic", "type": "song", "pattern": "%verb#1:base%, %verb#2:base%, %verb#3:base%", "weight": 1, "words": [3,3], "gate": { "minYear": 1963 },
      "slots": { "verb#1": { "pos": "verb", "filter": "defiant|spiritual|restless" } },
      "constraints": [ { "type": "same", "slots": ["verb#1","verb#2","verb#3"] } ] },
